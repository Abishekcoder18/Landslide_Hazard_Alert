# Copy to backend/.env (never commit .env).

# PostgreSQL + PostGIS database
DATABASE_URL=postgresql://resilion:resilion@localhost:5432/resilion
# All RESILION 2.0 tables live in this schema only (database may be shared with RESILION 1 in public).
DB_SCHEMA=resilion2
# auto = real NH-27 corridor from PostGIS when loaded (backend/scripts), else sample data
CORRIDOR_SOURCE=auto
# IMD rainfall date used for the real corridor's rainfall inputs (historical scenario)
SCENARIO_DATE=2022-05-10

# Anthropic API key for the photo check and alert writer (Claude Sonnet 5.5).
# Leave empty: reports go to manual review and alerts use the plain templates.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Long random string used to sign sign-in tokens
SECRET_KEY=change-me-to-a-long-random-string

# Frontend origin(s), comma-separated
CORS_ORIGINS=http://localhost:3000

CONTROL_ROOM_TZ=Asia/Kolkata
MAX_UPLOAD_MB=4
ALLOW_SAMPLE_RESET=true
